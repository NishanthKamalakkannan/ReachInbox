# ReachInbox Email Scheduler Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=super_secret_session_reachinbox_key_32bytes_min
JWT_SECRET=super_jwt_secret_reachinbox_token_key_32bytes_min

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://reachinbox_user:reachinbox_pass@localhost:5432/reachinbox_db?schema=public

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Worker & Queue Tuning
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth Credentials
# Obtain from: https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Ethereal Email SMTP Credentials
# Obtain from: https://ethereal.email/create
# Note: If left blank, the application automatically provisions a temporary Ethereal account on startup!
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
